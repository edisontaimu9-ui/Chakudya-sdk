{
  "name": "chakudya-sdk",
  "version": "1.0.0",
  "description": "Zero-dependency JS client for the Chakudya Nutrition Registry (CNR) Cloudflare Worker API (chakudya-api.edisontaimu9.workers.dev).",
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "chakudya-client.js"
  ],
  "author": "Edison Taimu",
  "repository": {
    "type": "git",
    "url": "https://github.com/edisontaimu9-ui/Chakudya-sdk.git"
  },
  "homepage": "https://github.com/edisontaimu9-ui/Chakudya-sdk#readme",
  "keywords": ["chakudya", "nutrition", "malawi", "food", "cloudflare-workers"],
  "license": "MIT"
}
